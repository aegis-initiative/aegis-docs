---
import Header from '../../components/Header.astro';
import Sidebar from '../../components/Sidebar.astro';
import Footer from '../../components/Footer.astro';
import techniques from '../../data/atx/techniques.json';
import index from '../../data/atx/index.json';
import versionMapping from '../../data/atx/version-mapping.json';

// The ATX-1 matrix grid is rendered from the canonical spec data fetched from
// aegis-governance.com at build time (scripts/fetch-atx.mjs -> src/data/atx/),
// the same source the technique-catalog MDX pages use. Do NOT hand-code
// technique data here: add techniques in aegis-governance and they appear here
// automatically. Only the editorial tactic short-names are local.

const TACTIC_SHORT = {
  TA001: 'Authority Boundaries',
  TA002: 'Operational Scope',
  TA003: 'System Integrity',
  TA004: 'Info Exfiltration',
  TA005: 'State Integrity',
  TA006: 'Resource Abuse',
  TA007: 'Agent Manipulation',
  TA008: 'Persistence',
  TA009: 'Evasion',
  TA010: 'Beyond Interpretation',
};

// Provenance ("Case Study") label, derived from canonical data only:
// Agents of Chaos case numbers when present, else the version-mapping discovery
// source (RFC-0006 / LoopTrap), else inherit parent, else em-dash.
const discoveryById = {};
for (const m of versionMapping.mappings || []) {
  if (m.v2_id && m.discovery) discoveryById[m.v2_id] = m.discovery;
}
function discoverySource(disc) {
  if (!disc) return '';
  if (/looptrap/i.test(disc)) return 'LoopTrap';
  if (/RFC-0006/i.test(disc)) return 'RFC-0006';
  return '';
}
function caseLabel(t, parentCase) {
  const aoc = t.agents_of_chaos_case || [];
  if (aoc.length) return aoc.map((n) => 'CS' + n).join(', ');
  const disc = discoverySource(discoveryById[t.id]);
  if (disc) return disc;
  return parentCase || '\u2014';
}
function rcCodes(rootCause) {
  const codes = (rootCause || '').match(/RC\d/g) || [];
  return [...new Set(codes)].join('+') || '\u2014';
}
function owaspLabel(arr) {
  return arr && arr.length ? arr.join('+') : '\u2014';
}

const byId = {};
for (const t of techniques) byId[t.id] = t;

const tacticMap = new Map();
for (const t of techniques) {
  if (t.id.includes('.')) continue; // sub-techniques attached below
  if (!tacticMap.has(t.tactic)) {
    tacticMap.set(t.tactic, {
      id: t.tactic,
      name: t.tactic_name,
      short: TACTIC_SHORT[t.tactic] || t.tactic_name,
      techniques: [],
    });
  }
  const parentCase = caseLabel(t, '');
  const entry = {
    id: t.id,
    name: t.name,
    root: rcCodes(t.root_cause),
    case: parentCase,
    owasp: owaspLabel(t.owasp_mapping),
    desc: t.description,
  };
  const subIds = t.sub_techniques || [];
  if (subIds.length) {
    entry.subTechniques = subIds
      .map((sid) => byId[sid])
      .filter(Boolean)
      .map((s) => ({
        id: s.id,
        name: s.name,
        root: rcCodes(s.root_cause),
        case: caseLabel(s, parentCase),
        owasp: owaspLabel(s.owasp_mapping),
        desc: s.description,
      }))
      .sort((a, b) => a.id.localeCompare(b.id));
  }
  tacticMap.get(t.tactic).techniques.push(entry);
}

const tactics = [...tacticMap.values()].sort((a, b) => a.id.localeCompare(b.id));
for (const tac of tactics) tac.techniques.sort((a, b) => a.id.localeCompare(b.id));

const tacticCount = tactics.length;
const techCount = techniques.filter((t) => !t.id.includes('.')).length;
const subCount = techniques.length - techCount;
const versionLabel = String(index.version || '').split('.').slice(0, 2).join('.');
---

<!doctype html>
<html lang="en" dir="ltr" data-theme="auto">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>ATX-1 v{versionLabel} Matrix — AEGIS Threat Matrix</title>
  <meta name="description" content={`Interactive matrix view of the ATX-1 v${versionLabel} threat taxonomy — ${tacticCount} tactics, ${techCount} techniques, ${subCount} sub-techniques for autonomous AI agent governance.`} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <script src="/shared/aegis-nav.js" defer></script>

  <link rel="preload" href="/fonts/ibmplexsans-variablefont_wdthwght-webfont.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/poppins-light-webfont.woff2" as="font" type="font/woff2" crossorigin />

  <script is:inline>
    (function () {
      const stored = localStorage.getItem("aegis-theme");
      const preferred = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      document.documentElement.dataset.theme = stored || preferred;
      document.documentElement.style.setProperty('--aegis-nav-height', '32px');
    })();
  </script>

  <style>
    @font-face {
      font-family: "IBM Plex Sans";
      src: url("/fonts/ibmplexsans-variablefont_wdthwght-webfont.woff2") format("woff2");
      font-weight: 100 700;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: "Poppins";
      src: url("/fonts/poppins-light-webfont.woff2") format("woff2");
      font-weight: 300;
      font-style: normal;
      font-display: swap;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --color-bg: #ffffff;
      --color-text: #1b1b1b;
      --color-text-secondary: #454545;
      --color-text-muted: #757575;
      --color-accent: #005ea2;
      --color-border: #d4d4d4;
      --color-border-subtle: #e8e8e8;
      --header-bg: #ffffff;
      --header-border: #d4d4d4;
      --sidebar-bg: #f8f8f8;
      --matrix-card-bg: #f4f4f4;
      --matrix-card-hover: #eaeaea;
      --matrix-header-bg: #e8e8e8;
      --overlay-bg: rgba(0,0,0,0.4);
      --detail-bg: #ffffff;
      --detail-meta-bg: #f4f4f4;
    }

    [data-theme="dark"] {
      --color-bg: #161616;
      --color-text: #f4f4f4;
      --color-text-secondary: #c6c6c6;
      --color-text-muted: #8d8d8d;
      --color-accent: #73b3e7;
      --color-border: #393939;
      --color-border-subtle: #262626;
      --header-bg: #1b1b1b;
      --header-border: #393939;
      --sidebar-bg: #1b1b1b;
      --matrix-card-bg: #1b1b1b;
      --matrix-card-hover: #262626;
      --matrix-header-bg: #262626;
      --overlay-bg: rgba(0,0,0,0.6);
      --detail-bg: #1b1b1b;
      --detail-meta-bg: #262626;
    }

    html {
      font-family: "Poppins", system-ui, sans-serif;
      font-size: 14px;
      font-weight: 300;
      line-height: 1.7;
      color: var(--color-text);
      background-color: var(--color-bg);
    }

    @media (min-width: 560px) { html { font-size: 16px; } }

    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    h1, h2, h3 {
      font-family: "IBM Plex Sans", system-ui, sans-serif;
      font-weight: 400;
      line-height: 1.3;
    }

    .page-wrapper {
      display: flex;
      flex: 1;
      width: 100%;
    }

    .main-content {
      flex: 1;
      min-width: 0;
      padding: 1.5rem;
    }

    @media (min-width: 1024px) {
      .main-content {
        margin-left: 320px;
      }
    }

    /* Matrix-specific styles */
    .matrix-hero {
      text-align: center;
      padding: 1.5rem 0 0.5rem;
    }

    .matrix-hero h1 {
      font-size: 1.6rem;
      margin-bottom: 0.4rem;
    }

    .matrix-hero p {
      color: var(--color-text-muted);
      font-size: 0.9rem;
      max-width: 700px;
      margin: 0 auto;
    }

    .legend {
      display: flex;
      justify-content: center;
      gap: 1.5rem;
      padding: 0.75rem 0 1rem;
      flex-wrap: wrap;
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.8rem;
      color: var(--color-text-muted);
    }

    .legend-dot {
      width: 12px;
      height: 12px;
      border-radius: 3px;
    }

    .matrix-container {
      overflow-x: auto;
      padding-bottom: 2rem;
    }

    .matrix {
      display: grid;
      grid-template-columns: repeat(10, minmax(120px, 1fr));
      gap: 3px;
      min-width: 1200px;
    }

    .tactic-header {
      background: var(--matrix-header-bg);
      border: 1px solid var(--color-border);
      border-radius: 6px 6px 0 0;
      padding: 0.6rem 0.4rem;
      text-align: center;
    }

    .tactic-id {
      font-family: 'Cascadia Code', 'Fira Code', monospace;
      font-size: 0.65rem;
      color: var(--color-text-muted);
      margin-bottom: 0.2rem;
    }

    .tactic-name {
      font-family: "IBM Plex Sans", system-ui, sans-serif;
      font-size: 0.75rem;
      font-weight: 600;
      line-height: 1.3;
    }

    .tactic-column {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .technique-cell {
      border-radius: 4px;
      padding: 0.5rem 0.4rem;
      cursor: pointer;
      transition: all 0.15s;
      border: 1px solid var(--color-border);
      background: var(--matrix-card-bg);
    }

    .technique-cell:hover {
      background: var(--matrix-card-hover);
      transform: translateY(-1px);
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    [data-theme="dark"] .technique-cell:hover {
      box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    }

    .technique-id {
      font-family: 'Cascadia Code', 'Fira Code', monospace;
      font-size: 0.6rem;
      color: var(--color-text-muted);
      margin-bottom: 0.15rem;
    }

    .technique-name {
      font-size: 0.7rem;
      font-weight: 500;
      line-height: 1.3;
    }


    /* Sub-techniques */
    .technique-cell.has-subtechniques {
      position: relative;
      padding-right: 1.6rem;
    }

    .subtech-toggle {
      position: absolute;
      bottom: 0.25rem;
      right: 0.25rem;
      display: inline-flex;
      align-items: center;
      gap: 0.15rem;
      padding: 0.1rem 0.3rem;
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: 3px;
      font-family: 'Cascadia Code', 'Fira Code', monospace;
      font-size: 0.6rem;
      color: var(--color-text-secondary);
      cursor: pointer;
      transition: all 0.15s;
    }

    .subtech-toggle:hover {
      background: var(--matrix-card-hover);
      color: var(--color-text);
    }

    .subtech-arrow {
      display: inline-block;
      transition: transform 0.2s ease;
      font-size: 0.7rem;
      line-height: 1;
    }

    .subtech-toggle[aria-expanded="true"] .subtech-arrow {
      transform: rotate(180deg);
    }

    .subtech-group {
      display: flex;
      flex-direction: column;
      gap: 3px;
      margin-top: 3px;
      padding-left: 0.5rem;
      border-left: 2px solid var(--color-accent);
    }

    .subtech-group[hidden] {
      display: none;
    }

    .subtech-cell {
      background: var(--color-bg);
      opacity: 0.95;
    }

    .subtech-cell .technique-id {
      color: var(--color-accent);
    }

    /* Detail overlay */
    .detail-overlay {
      display: none;
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: var(--overlay-bg);
      z-index: 200;
      align-items: center;
      justify-content: center;
      padding: 2rem;
    }

    .detail-overlay.active { display: flex; }

    .detail-panel {
      background: var(--detail-bg);
      border: 1px solid var(--color-border);
      border-radius: 12px;
      max-width: 560px;
      width: 100%;
      padding: 1.75rem;
      position: relative;
      max-height: 80vh;
      overflow-y: auto;
    }

    .detail-close {
      position: absolute;
      top: 0.75rem;
      right: 1rem;
      background: none;
      border: none;
      color: var(--color-text-muted);
      font-size: 1.5rem;
      cursor: pointer;
    }

    .detail-close:hover { color: var(--color-text); }

    .detail-panel h2 {
      font-size: 1.1rem;
      font-weight: 600;
      margin-bottom: 0.2rem;
      padding-right: 2rem;
    }

    .detail-panel .detail-id {
      font-family: 'Cascadia Code', 'Fira Code', monospace;
      font-size: 0.8rem;
      color: var(--color-text-muted);
      margin-bottom: 0.75rem;
    }

    .detail-panel .detail-desc {
      font-size: 0.9rem;
      color: var(--color-text-secondary);
      line-height: 1.6;
      margin-bottom: 1.25rem;
    }

    .detail-meta {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.6rem;
    }

    .detail-meta-item {
      background: var(--detail-meta-bg);
      border: 1px solid var(--color-border);
      border-radius: 6px;
      padding: 0.5rem 0.65rem;
    }

    .detail-meta-label {
      font-size: 0.65rem;
      color: var(--color-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.15rem;
    }

    .detail-meta-value {
      font-size: 0.8rem;
      font-weight: 500;
    }

    .detail-link {
      display: inline-block;
      margin-top: 1.25rem;
      color: var(--color-accent);
      text-decoration: none;
      font-size: 0.85rem;
    }

    .detail-link:hover { text-decoration: underline; }

    .matrix-links {
      display: flex;
      justify-content: center;
      gap: 1.5rem;
      padding: 0 0 1.5rem;
      font-size: 0.85rem;
    }

    .matrix-links a {
      color: var(--color-accent);
      text-decoration: none;
    }

    .matrix-links a:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <Header />
  <div class="page-wrapper">
    <Sidebar />
    <main class="main-content">

      <section class="matrix-hero">
        <h1>ATX-1 v{versionLabel}: AEGIS Threat Matrix</h1>
        <p>Adversarial knowledge base for autonomous AI agent behavior. {tacticCount} tactics, {techCount} techniques, {subCount} sub-techniques — empirically grounded in observed agentic failures and adversarial governance testing. Click the ▾ badge on a technique to expand its sub-techniques.</p>
      </section>

      <div class="matrix-links">
        <a href="/threat-matrix">Documentation</a>
        <a href="/threat-matrix/techniques">Technique Details</a>
        <a href="/threat-matrix/regulatory-crossref">Regulatory Mapping</a>
        <a href="https://aegis-governance.com/atx-1/index.json">Data (JSON)</a>
      </div>

      <div class="matrix-container">
        <div class="matrix">
          {tactics.map((tactic) => (
            <div class="tactic-column">
              <div class="tactic-header">
                <div class="tactic-id">{tactic.id}</div>
                <div class="tactic-name">{tactic.short}</div>
              </div>
              {tactic.techniques.map((tech) => (
                <>
                  <div
                    class={`technique-cell${tech.subTechniques ? ' has-subtechniques' : ''}`}
                    data-id={tech.id}
                    data-name={tech.name}
                    data-root={tech.root}
                    data-case={tech.case}
                    data-owasp={tech.owasp}
                    data-desc={tech.desc}
                    data-tactic={`${tactic.id}: ${tactic.name}`}
                  >
                    <div class="technique-id">{tech.id}</div>
                    <div class="technique-name">{tech.name}</div>
                    {tech.subTechniques && (
                      <button
                        type="button"
                        class="subtech-toggle"
                        aria-expanded="false"
                        aria-controls={`sub-${tech.id}`}
                        aria-label={`${tech.subTechniques.length} sub-techniques`}
                        data-parent={tech.id}
                      >
                        <span class="subtech-count">{tech.subTechniques.length}</span>
                        <span class="subtech-arrow" aria-hidden="true">▾</span>
                      </button>
                    )}
                  </div>
                  {tech.subTechniques && (
                    <div class="subtech-group" id={`sub-${tech.id}`} hidden>
                      {tech.subTechniques.map((sub) => (
                        <div
                          class="technique-cell subtech-cell"
                          data-id={sub.id}
                          data-name={sub.name}
                          data-root={sub.root}
                          data-case={sub.case}
                          data-owasp={sub.owasp}
                          data-desc={sub.desc}
                          data-tactic={`${tactic.id}: ${tactic.name}`}
                          data-parent-id={tech.id}
                        >
                          <div class="technique-id">{sub.id}</div>
                          <div class="technique-name">{sub.name}</div>
                        </div>
                      ))}
                    </div>
                  )}
                </>
              ))}
            </div>
          ))}
        </div>
      </div>

      <Footer />
    </main>
  </div>

  <div class="detail-overlay" id="detail-overlay">
    <div class="detail-panel">
      <button class="detail-close" id="detail-close">&times;</button>
      <h2 id="detail-name"></h2>
      <div class="detail-id" id="detail-id"></div>
      <div class="detail-desc" id="detail-desc"></div>
      <div class="detail-meta">
        <div class="detail-meta-item">
          <div class="detail-meta-label">Tactic</div>
          <div class="detail-meta-value" id="detail-tactic"></div>
        </div>
        <div class="detail-meta-item">
          <div class="detail-meta-label">Root Cause</div>
          <div class="detail-meta-value" id="detail-root"></div>
        </div>
        <div class="detail-meta-item">
          <div class="detail-meta-label">OWASP LLM</div>
          <div class="detail-meta-value" id="detail-owasp"></div>
        </div>
        <div class="detail-meta-item">
          <div class="detail-meta-label">Case Study</div>
          <div class="detail-meta-value" id="detail-case"></div>
        </div>
      </div>
      <a class="detail-link" id="detail-link" href="#">View full technique details &rarr;</a>
    </div>
  </div>

  <script is:inline>
    // Sub-technique accordion toggles
    document.querySelectorAll('.subtech-toggle').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        var parentId = btn.dataset.parent;
        var group = document.getElementById('sub-' + parentId);
        if (!group) return;
        var expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
        group.hidden = expanded;
      });
    });

    document.querySelectorAll('.technique-cell').forEach(function(cell) {
      cell.addEventListener('click', function(e) {
        if (e.target.closest('.subtech-toggle')) return;
        var overlay = document.getElementById('detail-overlay');
        document.getElementById('detail-name').textContent = cell.dataset.name;
        document.getElementById('detail-id').textContent = cell.dataset.id + ' \u2014 ' + cell.dataset.tactic;
        document.getElementById('detail-desc').textContent = cell.dataset.desc;
        document.getElementById('detail-tactic').textContent = cell.dataset.tactic;
        document.getElementById('detail-root').textContent = cell.dataset.root;
        document.getElementById('detail-owasp').textContent = cell.dataset.owasp;
        document.getElementById('detail-case').textContent = cell.dataset.case;
        document.getElementById('detail-link').href = '/threat-matrix/techniques#' + cell.dataset.id.toLowerCase();
        overlay.classList.add('active');
      });
    });

    document.getElementById('detail-close').addEventListener('click', function() {
      document.getElementById('detail-overlay').classList.remove('active');
    });

    document.getElementById('detail-overlay').addEventListener('click', function(e) {
      if (e.target === e.currentTarget) {
        e.currentTarget.classList.remove('active');
      }
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        document.getElementById('detail-overlay').classList.remove('active');
      }
    });
  </script>
</body>
</html>
